<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).tools/nuget/packages</RestorePackagesPath>
  </PropertyGroup>
</Project>
