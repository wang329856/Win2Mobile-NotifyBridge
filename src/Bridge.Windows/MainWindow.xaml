<Window x:Class="Win2Mobile.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win2Mobile.Windows" Title="Win2Mobile · 安全通知桥" Width="1020" Height="760" MinWidth="820" MinHeight="620" FontFamily="Microsoft YaHei UI" Background="#F5F7FB" Loaded="WindowLoaded" Closing="WindowClosing">
 <Window.Resources><local:LocalTimeConverter x:Key="LocalTime"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Win2Mobile" FontSize="26" FontWeight="Bold"/><TextBlock Text="将本次登录会话的新系统通知同步到已配对的 Android 手机" Foreground="#596579" Margin="0,4,0,12"/></StackPanel>
  <Border Grid.Row="1" Padding="12" Background="White" CornerRadius="8" Margin="0,0,0,12"><StackPanel>
   <TextBlock x:Name="CaptureStatus" Text="正在检查通知权限…"/><TextBlock x:Name="ServiceStatus" Text="局域网服务尚未启动" Margin="0,4,0,0"/>
   <WrapPanel Margin="0,8,0,0"><Button Content="授权通知访问" Click="AuthorizeClick"/><Button x:Name="PauseButton" Content="暂停采集" Click="PauseClick"/><Button Content="发送测试通知" Click="SendTestClick"/><Button Content="打开 Windows 通知隐私设置" Click="PrivacyClick"/></WrapPanel>
  </StackPanel></Border>
  <TabControl Grid.Row="2" Background="White">
   <TabItem Header="跨网络推送"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="无需租服务器，手机使用移动数据也能接收" FontSize="18" FontWeight="Bold"/>
    <TextBlock Text="电脑先按手机独立加密，再向 ntfy 发布密文。支持局域网扫码及完全远程配对；开启后可生成远程二维码，通过可信渠道交给自己的手机。" TextWrapping="Wrap" Margin="0,12,0,12"/>
    <CheckBox x:Name="NtfyEnabledCheck" Content="启用 ntfy 跨网络推送" Margin="0,0,0,12"/>
    <TextBlock Text="ntfy 服务地址（默认使用免费公共服务）"/>
    <TextBox x:Name="NtfyServerText" Text="https://ntfy.sh" Margin="0,6,0,8"/>
    <TextBlock Text="电脑 HTTP 代理（可选，留空使用系统网络）"/>
    <TextBox x:Name="NtfyProxyText" Margin="0,6,0,8"/>
    <Button x:Name="NtfyApplyButton" Content="应用跨网络设置" Click="NtfyApplyClick" HorizontalAlignment="Left"/>
    <TextBlock x:Name="NtfyStatus" Text="跨网络推送已关闭" TextWrapping="Wrap" Margin="0,12,0,16"/>
    <WrapPanel><Button x:Name="RemotePairButton" Content="生成远程配对二维码" Click="RemotePairClick"/><Button Content="复制远程配对信息" Click="CopyRemotePairClick"/></WrapPanel>
    <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><Image x:Name="RemotePairQr" Width="300" Height="300" HorizontalAlignment="Left"/>
      <TextBlock x:Name="RemotePairStatus" Text="二维码含一次性配对秘密，有效 120 秒。手机扫码后，在右侧核对同样的六位码并批准。请勿公开分享二维码。" TextWrapping="Wrap" Margin="0,8,12,8"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="16,0,0,0">
      <TextBlock Text="核对手机与电脑的六位校验码" FontSize="18" FontWeight="Bold"/>
      <TextBlock x:Name="RemotePendingHint" Text="收到手机请求后，校验码会显示在下方；无需手动输入。" TextWrapping="Wrap" Margin="0,8,0,8"/>
      <ListBox x:Name="RemotePendingList" Height="160"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
       <TextBlock Text="{Binding DeviceName}"/><TextBlock Text="{Binding VerificationCode}" FontSize="28" FontWeight="Bold" Foreground="#2266BB"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock Text="选择自己的手机，仅在两端六位码完全相同时批准。" TextWrapping="Wrap" Margin="0,8,0,8"/>
      <WrapPanel><Button Content="核对一致，批准选中手机" Click="ApproveRemoteClick"/><Button Content="拒绝" Click="DenyRemoteClick"/></WrapPanel>
     </StackPanel>
    </Grid>
    <TextBlock Text="通知内容使用端到端加密；远程授权使用临时密钥协商和六位校验码，将通知密钥单独加密交给获准手机。公共中转仍可见 IP、随机 topic、消息大小与时间。" TextWrapping="Wrap" Margin="0,8,0,8"/>
    <TextBlock Text="免费服务有每日消息与请求限制；每部手机和每个长消息分片分别计入限额。达到限制时电脑保存通知并重试。中转缓存过期后请切回局域网补齐历史，不能保证长期离线送达。" TextWrapping="Wrap" Margin="0,8,0,8"/>
    <TextBlock Text="电脑需运行并能访问所选服务。手机在电脑页可切换跨网络与局域网接收；后台仍受 Android 电池策略影响。撤销授权会停止向该手机发布后续通知，已发送的密文无法追回。" TextWrapping="Wrap" Margin="0,8,0,8"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="配对手机"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="1. 手机与电脑连接同一局域网" FontWeight="Bold"/><TextBlock Text="2. 选择手机可访问的电脑地址" Margin="0,8,0,4"/><ComboBox x:Name="Addresses" SelectionChanged="AddressChanged"/><Button Content="重新扫描网卡地址" Click="RescanClick"/><Image x:Name="PairingQr" Width="260" Height="260" Margin="0,10,0,5"/><TextBlock x:Name="QrStatus"/><TextBlock x:Name="PairingAddress" Foreground="#596579" Margin="0,5,0,0"/><Button Content="刷新二维码（120 秒有效）" Click="RefreshQrClick"/><TextBlock Text="3. 手机扫码后，在右侧核对设备名称并批准。刷新后旧二维码失效。请勿分享二维码。" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="等待本机批准" FontSize="18" FontWeight="Bold"/><TextBlock Text="仅批准您正在操作的手机。配对请求将在 120 秒内过期。" Margin="0,8,0,8"/><ListBox x:Name="PendingList" Height="180"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DeviceName}"/><TextBlock Text="{Binding VerificationCode, StringFormat=远程校验码：{0}}" FontWeight="Bold" Foreground="#2266BB"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding VerificationCode}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="批准选中请求" Click="ApproveClick"/><Button Content="拒绝选中请求" Click="DenyClick"/></WrapPanel><TextBlock Text="已配对设备" FontSize="18" FontWeight="Bold" Margin="0,22,0,8"/><ListBox x:Name="DeviceList" Height="180"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding DeviceName}" FontWeight="Bold"/><TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="#596579"/><TextBlock Text="{Binding AcknowledgedSequence, StringFormat=已保存通知游标：{0}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="撤销选中设备（停止后续发送）" Click="RevokeClick"/></StackPanel>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="发送队列"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions><DataGrid x:Name="RecentList" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="RecentChanged"><DataGrid.Columns><DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="65"/><DataGridTextColumn Header="应用" Binding="{Binding AppName}" Width="130"/><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="时间（本地）" Binding="{Binding OccurredAt, Converter={StaticResource LocalTime}}" Width="140"/></DataGrid.Columns></DataGrid><TextBox x:Name="NotificationDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Grid></TabItem>
   <TabItem Header="应用过滤"><StackPanel Margin="16"><TextBlock Text="取消勾选的应用不会入库或发送。过滤使用 Windows 稳定应用 ID，列表随着系统通知出现更新。" Margin="0,0,0,12"/><ListBox x:Name="AppList" Height="350"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled}" Checked="FilterChanged" Unchecked="FilterChanged" Margin="4"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding AppId}" FontSize="11" Foreground="#596579"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></TabItem>
   <TabItem Header="设置与说明"><StackPanel Margin="16"><TextBlock Text="桌面代理在当前用户会话中运行，不安装 Windows 系统服务。关闭窗口后保留在系统托盘；从托盘菜单可彻底退出。"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动（系统允许时）" Margin="0,20,0,8" Click="StartupClick"/><TextBlock x:Name="StartupStatus"/><TextBlock Text="传输：HTTPS / WSS，默认端口 47721。二维码绑定本机证书指纹。手机需可访问所选局域网地址；如 Windows 防火墙拦截，请检查私人网络的入站规则。" Margin="0,20,0,8"/><TextBlock Text="采集范围：Windows 系统 Toast。应用自身界面内的消息、弹窗或聊天历史不在采集范围。暂停期间通知不会补发；每次启动先以已有通知为基线。" Margin="0,10,0,8"/><TextBlock Text="电脑只保留短期发送队列：最多 24 小时、1000 条，超期或超量自动清理；授权和首次连接前的通知不会作为新通知发送。" TextWrapping="Wrap" Margin="0,10,0,8"/><TextBlock x:Name="DataPath" Margin="0,10,0,8"/><Button Content="打开用户数据目录" Click="OpenDataClick" HorizontalAlignment="Left"/></StackPanel></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" x:Name="ActionStatus" Foreground="#596579" Margin="0,10,0,0" Text="请先扫码配对；跨网络功能需单独开启。"/>
 </Grid>
</Window>
