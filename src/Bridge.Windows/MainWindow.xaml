<Window x:Class="Win2Mobile.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win2Mobile.Windows" Title="Win2Mobile · 局域网通知桥" Width="1020" Height="760" MinWidth="820" MinHeight="620" FontFamily="Microsoft YaHei UI" Background="#F5F7FB" Loaded="WindowLoaded" Closing="WindowClosing">
 <Window.Resources><local:LocalTimeConverter x:Key="LocalTime"/></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Win2Mobile" FontSize="26" FontWeight="Bold"/><TextBlock Text="将本次登录会话的新系统通知同步到已配对的 Android 手机" Foreground="#596579" Margin="0,4,0,12"/></StackPanel>
  <Border Grid.Row="1" Padding="12" Background="White" CornerRadius="8" Margin="0,0,0,12"><StackPanel>
   <TextBlock x:Name="CaptureStatus" Text="正在检查通知权限…"/><TextBlock x:Name="ServiceStatus" Text="局域网服务尚未启动" Margin="0,4,0,0"/>
   <WrapPanel Margin="0,8,0,0"><Button Content="授权通知访问" Click="AuthorizeClick"/><Button x:Name="PauseButton" Content="暂停采集" Click="PauseClick"/><Button Content="发送测试通知" Click="SendTestClick"/><Button Content="打开 Windows 通知隐私设置" Click="PrivacyClick"/></WrapPanel>
  </StackPanel></Border>
  <TabControl Grid.Row="2" Background="White">
   <TabItem Header="配对手机"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="1. 手机与电脑连接同一局域网" FontWeight="Bold"/><TextBlock Text="2. 选择手机可访问的电脑地址" Margin="0,8,0,4"/><ComboBox x:Name="Addresses" SelectionChanged="AddressChanged"/><Button Content="重新扫描网卡地址" Click="RescanClick"/><Image x:Name="PairingQr" Width="260" Height="260" Margin="0,10,0,5"/><TextBlock x:Name="QrStatus"/><TextBlock x:Name="PairingAddress" Foreground="#596579" Margin="0,5,0,0"/><Button Content="刷新二维码（120 秒有效）" Click="RefreshQrClick"/><TextBlock Text="3. 手机扫码后，在右侧核对设备名称并批准。刷新后旧二维码失效。请勿分享二维码。" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="等待本机批准" FontSize="18" FontWeight="Bold"/><TextBlock Text="仅批准您正在操作的手机。配对请求将在 120 秒内过期。" Margin="0,8,0,8"/><ListBox x:Name="PendingList" Height="180" DisplayMemberPath="DeviceName"/><WrapPanel><Button Content="批准选中请求" Click="ApproveClick"/><Button Content="拒绝选中请求" Click="DenyClick"/></WrapPanel><TextBlock Text="已配对设备" FontSize="18" FontWeight="Bold" Margin="0,22,0,8"/><ListBox x:Name="DeviceList" Height="180"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding DeviceName}" FontWeight="Bold"/><TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="#596579"/><TextBlock Text="{Binding AcknowledgedSequence, StringFormat=已保存通知游标：{0}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="撤销选中设备（立即断开手机）" Click="RevokeClick"/></StackPanel>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="近期通知"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions><DataGrid x:Name="RecentList" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="RecentChanged"><DataGrid.Columns><DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="65"/><DataGridTextColumn Header="应用" Binding="{Binding AppName}" Width="130"/><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="时间（本地）" Binding="{Binding OccurredAt, Converter={StaticResource LocalTime}}" Width="140"/></DataGrid.Columns></DataGrid><TextBox x:Name="NotificationDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Grid></TabItem>
   <TabItem Header="应用过滤"><StackPanel Margin="16"><TextBlock Text="取消勾选的应用不会入库或发送。过滤使用 Windows 稳定应用 ID，列表随着系统通知出现更新。" Margin="0,0,0,12"/><ListBox x:Name="AppList" Height="350"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled}" Checked="FilterChanged" Unchecked="FilterChanged" Margin="4"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding AppId}" FontSize="11" Foreground="#596579"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></TabItem>
   <TabItem Header="设置与说明"><StackPanel Margin="16"><TextBlock Text="桌面代理在当前用户会话中运行，不安装 Windows 系统服务。关闭窗口后保留在系统托盘；从托盘菜单可彻底退出。"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动（系统允许时）" Margin="0,20,0,8" Click="StartupClick"/><TextBlock x:Name="StartupStatus"/><TextBlock Text="传输：HTTPS / WSS，默认端口 47721。二维码绑定本机证书指纹。手机需可访问所选局域网地址；如 Windows 防火墙拦截，请检查私人网络的入站规则。" Margin="0,20,0,8"/><TextBlock Text="采集范围：Windows 系统 Toast。应用自身界面内的消息、弹窗或聊天历史不在采集范围。暂停期间通知不会补发；每次启动先以已有通知为基线。" Margin="0,10,0,8"/><TextBlock x:Name="DataPath" Margin="0,10,0,8"/><Button Content="打开用户数据目录" Click="OpenDataClick" HorizontalAlignment="Left"/></StackPanel></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" x:Name="ActionStatus" Foreground="#596579" Margin="0,10,0,0" Text="配对及通知内容仅保存在当前用户的数据目录。"/>
 </Grid>
</Window>
