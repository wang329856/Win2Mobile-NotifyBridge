<Window x:Class="Win2Mobile.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win2Mobile.Windows" Icon="Assets/Win2Mobile.ico" Title="Win2Mobile" Width="1120" Height="800" MinWidth="800" MinHeight="580" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource TextBrush}" PreviewMouseDown="ButtonPressFeedback" PreviewMouseUp="ButtonReleaseFeedback" PreviewKeyDown="WindowKeyDown" Background="{DynamicResource CanvasBrush}" Loaded="WindowLoaded" Closing="WindowClosing" SizeChanged="LayoutChanged">
 <Window.Resources>
  <local:LocalTimeConverter x:Key="LocalTime"/>
  <DataTemplate x:Key="NotificationCard"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AppName}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding OccurredAt, Converter={StaticResource LocalTime}}" Style="{StaticResource Hint}"/></Grid><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,4" TextTrimming="CharacterEllipsis" MaxHeight="48"/><TextBlock Text="{Binding Body}" Style="{StaticResource Hint}" MaxHeight="42" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate>
 </Window.Resources>
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="14,26,14,18">
   <StackPanel DockPanel.Dock="Top" Margin="4,0,0,28"><Image Source="Assets/BrandLogo.png" Width="42" Height="42" HorizontalAlignment="Left" AutomationProperties.Name="Win2Mobile：电脑通知同步到手机" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="BrandName" Text="Win2Mobile" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock x:Name="BrandHint" Text="通知，随你而行" Style="{StaticResource Hint}"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="{DynamicResource SoftBrush}" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="● 安全通知桥" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/><TextBlock x:Name="SidebarHint" Text="端到端加密 · 私人设备" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
   <StackPanel>
    <Button x:Name="NavOverview" AutomationProperties.Name="概览" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="0" ToolTip="概览"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock x:Name="LabelOverview" Text="概览" Margin="14,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavDevices" AutomationProperties.Name="设备" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="1" ToolTip="设备"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock x:Name="LabelDevices" Text="设备" Margin="14,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavNotices" AutomationProperties.Name="通知" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="2" ToolTip="通知"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock x:Name="LabelNotices" Text="通知" Margin="14,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavRules" AutomationProperties.Name="规则" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="3" ToolTip="规则"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock x:Name="LabelRules" Text="规则" Margin="14,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavSettings" AutomationProperties.Name="设置" Style="{StaticResource NavButton}" Command="{Binding Navigate}" CommandParameter="4" ToolTip="设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock x:Name="LabelSettings" Text="设置" Margin="14,0,0,0"/></StackPanel></Button>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,24,28,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="让通知，跟上你的节奏" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="电脑上的重要消息，随时在手机查看。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ 连接手机" Style="{StaticResource PrimaryButton}" Click="OpenPairClick" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
   <Button Grid.Row="1" x:Name="PendingBanner" Visibility="Collapsed" HorizontalContentAlignment="Left" Background="{DynamicResource AccentSoftBrush}" Click="OpenPairClick" Margin="0,0,0,16"><TextBlock x:Name="PendingBannerText" Text="有新的配对请求 · 点击核验并批准" FontWeight="SemiBold"/></Button>
   <Grid Grid.Row="2" x:Name="PageHost">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border CornerRadius="24" Background="{DynamicResource AccentSoftBrush}" Padding="26" Margin="0,0,0,18"><StackPanel><TextBlock Text="电脑与手机 · 一座私人通知桥" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding CaptureHeading}" FontSize="27" FontWeight="Bold" Margin="0,12,0,8"/><TextBlock x:Name="CaptureStatus" Text="正在检查通知权限…" Style="{StaticResource Hint}"/><TextBlock x:Name="ServiceStatus" Text="正在启动连接服务" Style="{StaticResource Hint}" Margin="0,4,0,14"/><WrapPanel><Button x:Name="PauseButton" Content="暂停采集" Style="{StaticResource PrimaryButton}" Click="PauseClick"/><Button x:Name="AuthorizeButton" Content="授权通知访问" Click="AuthorizeClick"/><Button Content="发送测试通知" Click="SendTestClick"/></WrapPanel></StackPanel></Border>
     <Grid x:Name="SummaryGrid" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="DevicesSummaryCard" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="你的手机" Style="{StaticResource Hint}"/><TextBlock Text="{Binding DeviceSummary}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/><TextBlock Text="只有批准的设备能接收通知" Style="{StaticResource Hint}"/><Button Content="管理设备 →" Style="{StaticResource QuietButton}" Command="{Binding Navigate}" CommandParameter="1" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
      <Border x:Name="QueueSummaryCard" Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Text="短期发送队列" Style="{StaticResource Hint}"/><TextBlock Text="{Binding QueueSummary}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/><TextBlock Text="最多 24 小时 · 1000 条" Style="{StaticResource Hint}"/><Button Content="查看通知 →" Style="{StaticResource QuietButton}" Command="{Binding Navigate}" CommandParameter="2" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     </Grid>
     <TextBlock Text="最近的通知" Style="{StaticResource Heading}"/><TextBlock x:Name="OverviewEmpty" Text="连接手机后，新的电脑通知会出现在这里。" Style="{StaticResource Hint}" Margin="0,0,0,14"/><ListBox x:Name="OverviewRecent" ItemTemplate="{StaticResource NotificationCard}" SelectionChanged="OverviewRecentChanged" MaxHeight="340"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="DevicesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="连一次，以后更轻松" Style="{StaticResource Heading}"/><TextBlock Text="同网时直连，离开 Wi-Fi 后可用加密中转。配对时请核对正在操作的设备。" Style="{StaticResource Hint}"/><Button Content="＋ 扫码连接新手机" Click="OpenPairClick" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><ListBox x:Name="DeviceList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DeviceName}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="● 已授权 · 可接收新的电脑通知" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/><Expander Header="授权详情"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding DeviceId, StringFormat=设备标识：{0}}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding AcknowledgedSequence, StringFormat=局域网保存进度：{0}}" Style="{StaticResource Hint}"/><Button Content="撤销此手机授权" Foreground="{DynamicResource DangerBrush}" Click="RevokeRowClick" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    <Grid x:Name="NoticesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="NoticeSearch" TextChanged="NoticeSearchChanged" ToolTip="搜索应用、标题和正文" AutomationProperties.Name="搜索应用、标题和正文" Margin="0,0,0,8"/><TextBlock Text="搜索应用、标题或正文 · 这里只保留短期发送队列" Style="{StaticResource Hint}" Grid.Row="1" Margin="0,0,0,16"/>
     <Grid x:Name="NotificationSplit" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="320"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions><ListBox x:Name="RecentList" ItemTemplate="{StaticResource NotificationCard}" SelectionChanged="RecentChanged" Margin="0,0,14,0"/><Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="通知详情" Style="{StaticResource Heading}"/><TextBox x:Name="NotificationDetails" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False" Text="选择一条通知，查看完整内容。" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/><Button x:Name="CopyNoticeButton" IsEnabled="False" Grid.Row="2" Content="复制完整内容" Click="CopyNoticeClick" Margin="0,12,0,0"/></Grid></Border></Grid>
    </Grid>
    <Grid x:Name="RulesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="RuleSearch" ToolTip="搜索应用" AutomationProperties.Name="搜索通知来源" TextChanged="RuleSearchChanged"/><StackPanel Grid.Row="1" Margin="0,12,0,12"><TextBlock Text="选择哪些应用可以转发；未出现过通知的应用会在首次出现时加入列表。" Style="{StaticResource Hint}"/><WrapPanel Margin="0,12,0,0"><Button Content="全部允许" Tag="True" Click="BulkFilterClick"/><Button Content="全部关闭" Tag="False" Click="BulkFilterClick"/></WrapPanel></StackPanel><ListBox x:Name="AppList" Grid.Row="2"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Checked="FilterChanged" Unchecked="FilterChanged"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding AppId}" Style="{StaticResource Hint}"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="外观与启动" Style="{StaticResource Heading}"/><TextBlock Text="主题" Style="{StaticResource Hint}"/><ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox><CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动" Click="StartupClick"/><TextBlock x:Name="StartupStatus" Style="{StaticResource Hint}"/><TextBlock Text="关闭窗口后继续在托盘运行；右键托盘可暂停或退出。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="跨网络推送" Style="{StaticResource Heading}"/><TextBlock Text="离开同一 Wi-Fi，也能接收。通知内容先加密，再经 ntfy 转发。" Style="{StaticResource Hint}"/><CheckBox x:Name="NtfyEnabledCheck" Content="启用加密跨网络推送" Click="NtfyToggleClick"/><TextBlock x:Name="NtfyStatus" Text="跨网络推送已关闭" Style="{StaticResource Hint}"/><Expander Header="服务地址与代理"><StackPanel Margin="0,12,0,0"><TextBlock Text="中转服务地址" Style="{StaticResource Hint}"/><TextBox x:Name="NtfyServerText" Text="https://ntfy.sh" Margin="0,6,0,12"/><TextBlock Text="HTTP 代理 · 留空使用系统网络" Style="{StaticResource Hint}"/><TextBox x:Name="NtfyProxyText" Margin="0,6,0,12"/><Button x:Name="NtfyApplyButton" Content="保存网络设置" Click="NtfyApplyClick" HorizontalAlignment="Left"/></StackPanel></Expander><Expander Header="中转与送达说明"><TextBlock Text="公共中转可见 IP、消息大小和时间，但不持有通知密钥。免费服务有请求与缓存限制，电脑会在短期队列期限内重试。中转连接不代表手机已保存或电脑在线。撤销只阻止后续发送，已缓存密文无法追回。" Style="{StaticResource Hint}" Margin="0,12,0,0"/></Expander></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="权限与诊断" Style="{StaticResource Heading}"/><Button Content="Windows 通知隐私设置" Click="PrivacyClick" HorizontalAlignment="Left"/><TextBlock Text="采集 Windows 系统 Toast；每次启动先建立基线，电脑暂停期间的通知不会补发。首次授权前的记录不会交给新手机。" Style="{StaticResource Hint}"/><TextBlock Text="HTTPS / WSS · 47721 端口。手机无法直连时，检查私人网络、防火墙与电脑当前地址。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock x:Name="DataPath" Style="{StaticResource Hint}" Margin="0,10,0,10"/><Button Content="打开数据目录" Click="OpenDataClick" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="3" x:Name="ActionStatus" Text="准备好后，连接你的第一部手机。" Style="{StaticResource Hint}" Margin="0,12,0,0" MaxHeight="46"/>
  </Grid>
  <Border x:Name="PairPanel" KeyboardNavigation.TabNavigation="Cycle" Grid.ColumnSpan="2" Background="#88000000" Visibility="Collapsed"><Border Style="{StaticResource Card}" CornerRadius="24" MaxWidth="850" Margin="32,20" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <DockPanel><Button Content="关闭 ×" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="ClosePairClick"/><StackPanel><TextBlock Text="连接你的手机" FontSize="28" FontWeight="Bold"/><TextBlock Text="扫码 → 核验 → 批准，即可开始接收。" Style="{StaticResource Hint}" Margin="0,5,0,12"/></StackPanel></DockPanel>
   <WrapPanel><Button x:Name="LanModeButton" Content="同一局域网" Click="LanModeClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="RemoteModeButton" Content="跨网络连接" Click="RemoteModeClick"/></WrapPanel>
   <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{DynamicResource SoftBrush}" CornerRadius="16" Padding="18" Margin="0,0,16,0"><StackPanel>
    <StackPanel x:Name="LanPairSection"><TextBlock x:Name="PairComputerName" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,12"/><Image x:Name="PairingQr" Width="240" Height="240" HorizontalAlignment="Center"/><TextBlock x:Name="QrStatus" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock x:Name="PairingAddress" Style="{StaticResource Hint}" HorizontalAlignment="Center"/><Button Content="刷新二维码" Click="RefreshQrClick" HorizontalAlignment="Center" Margin="0,12,0,0"/><Expander Header="选择其他电脑地址"><StackPanel><ComboBox x:Name="Addresses" SelectionChanged="AddressChanged"/><Button Content="重新扫描网卡" Click="RescanClick" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel>
    <StackPanel x:Name="RemotePairSection" Visibility="Collapsed"><TextBlock Text="两端可以位于不同网络。通过可信渠道交给自己的手机，并核对六位码。" Style="{StaticResource Hint}"/><Button x:Name="RemotePairButton" Content="启用跨网络并生成二维码" Click="RemotePairClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,12,0,12"/><Image x:Name="RemotePairQr" Width="240" Height="240"/><TextBlock x:Name="RemoteQrCountdown" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock x:Name="RemotePairStatus" Text="二维码有效 120 秒，请勿公开分享。" Style="{StaticResource Hint}" Margin="0,12,0,8"/><Button Content="复制配对信息" Click="CopyRemotePairClick" HorizontalAlignment="Center"/></StackPanel>
   </StackPanel></Border>
   <StackPanel Grid.Column="1"><TextBlock Text="等待你批准" Style="{StaticResource Heading}"/><TextBlock x:Name="RemotePendingHint" Text="手机扫码后，请求会显示在这里。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
   <ListBox x:Name="PendingList" MaxHeight="240"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DeviceName}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding VerificationCode}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,6"/><TextBlock Text="远程配对请先确认此码与手机一致；仅批准自己正在操作的手机。" Style="{StaticResource Hint}"/><WrapPanel Margin="0,12,0,0"><Button Content="核验后批准" Style="{StaticResource PrimaryButton}" Click="ApproveRowClick"/><Button Content="拒绝" Click="DenyRowClick"/></WrapPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <ListBox x:Name="RemotePendingList" Visibility="Collapsed"/></StackPanel></Grid><TextBlock Text="{Binding Text, ElementName=ActionStatus}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer></Border></Border>
 </Grid>
</Window>
